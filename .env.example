# Copy this file to .env (locally) or set these as environment variables on your
# host. NEVER commit a real .env — this repo is public.

# --- Telegram alerts ---
# Set BOTH names to the same bot token (the codebase reads both spellings).
BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# --- Inbound webhook auth (alertatron) ---
WEBHOOK_SECRET=your_webhook_secret_here

# --- Database (required for the app to boot) ---
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# --- Market data feed ---
USE_TWELVEDATA=true
TWELVEDATA_API_KEY=your_twelvedata_key_here

# --- Optional integrations ---
ALERTATRON_API_KEY=your_alertatron_key_here
METATRADER_LOGIN=your_mt5_login_optional
METATRADER_PASSWORD=your_mt5_password_optional
METATRADER_SERVER=your_mt5_server_optional

# --- CORS (optional) ---
# Comma-separated list of allowed dashboard origins. Leave as * for open access
# (credentials disabled). Set real origins to enable credentialed requests.
ALLOWED_ORIGINS=*

# --- USD/JPY forward-test scanner ---
USDJPY_SCANNER_ENABLED=false   # true to run the once-a-day auto-scan
USDJPY_SCAN_HOUR_UTC=22         # hour (0-23 UTC) to fetch the daily close
USDJPY_ACCOUNT_SIZE=0           # demo account size in USD for sizing alerts (0 = skip)
