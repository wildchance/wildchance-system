BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

WEBHOOK_SECRET=your_webhook_secret_here

DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

USE_TWELVEDATA=true
TWELVEDATA_API_KEY=your_twelvedata_key_here

ALERTATRON_API_KEY=your_alertatron_key_here
METATRADER_LOGIN=your_mt5_login_optional
METATRADER_PASSWORD=your_mt5_password_optional
METATRADER_SERVER=your_mt5_server_optional

# --- USD/JPY forward-test scanner (optional) ---
USDJPY_SCANNER_ENABLED=false
USDJPY_SCAN_HOUR_UTC=22
USDJPY_ACCOUNT_SIZE=0

# --- Wildchance Confluence Engine (wildchance/) ---
# Read by wildchance/wildchance_scraper.py. All optional — each source
# falls back to a snapshot if its credential is unset.
# The scraper accepts TWELVEDATA_API_KEY above, or TWELVEDATA_KEY here.
TWELVEDATA_KEY=your_twelvedata_key_here
MYFXBOOK_EMAIL=you@email.com
MYFXBOOK_PASSWORD=your_myfxbook_password
GOLD_COT_COHORT=managed_money
