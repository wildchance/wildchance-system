# =============================================
# Wildchance System — Environment Variables
# =============================================

# --- Telegram Alerts ---
BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Inbound Webhook Auth ---
WEBHOOK_SECRET=your_webhook_secret_here

# --- Database (Required) ---
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# --- Real-Time Market Data ---
USE_TWELVEDATA=true
TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# --- Polygon.io (New Real-Time Streaming) ---
POLYGON_API_KEY=your_polygon_api_key_here

# --- Redis (Cache + Pub/Sub for real-time ticks) ---
REDIS_URL=redis://localhost:6379

# --- Optional Integrations ---
ALERTATRON_API_KEY=your_alertatron_key_here
METATRADER_LOGIN=your_mt5_login
METATRADER_PASSWORD=your_mt5_password
METATRADER_SERVER=your_mt5_server

# --- CORS ---
ALLOWED_ORIGINS=*

# --- USD/JPY Scanner ---
USDJPY_SCANNER_ENABLED=false
USDJPY_SCAN_HOUR_UTC=22
USDJPY_ACCOUNT_SIZE=0

# =============================================
# Notes:
# 1. Copy this file to .env locally
# 2. NEVER commit real secrets
# 3. On Render: Add these as Environment Variables
# 4. Get Polygon key at: https://polygon.io
# =============================================

# --- WildChance v4 (pipeline / lunar / prop challenge) ---
# Lunar overlay: OFF until GET /lunar/backtest shows evidence on YOUR instrument
LUNAR_GATE_ENABLED=false
LUNAR_OBS_HOURS=24
LUNAR_PAUSE_IN_OBS=false
# Free data fallback when TwelveData is empty/out of credits (gold = GC=F futures, ~$20-40 off spot)
YAHOO_FALLBACK_ENABLED=false

# --- MT5 VPS connector (mt5_bridge/connector.py) — set on the VPS, not the app ---
# CHALLENGE_INITIAL_BALANCE=10000      # the challenge's starting balance (set it!)
# CHALLENGE_DAILY_LOSS=0.05            # firm daily loss (FundingPips 2-Step: 5%)
# CHALLENGE_MAX_LOSS=0.10              # firm max loss (10%)
# CHALLENGE_TARGET=0.08                # phase target (P1 0.08, P2 0.05, 0 = off)
# GUARD_DAILY_BUFFER=0.70              # stop at 70% of the daily limit (3.5%)
# GUARD_MAX_BUFFER=0.80                # stop at 80% of the max loss (8%)
# SYMBOL_MAP={"XAUUSD":"XAUUSD","EURUSD":"EURUSD"}   # unset = gold-only
