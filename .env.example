# =============================================
# Wildchance System — Environment Variables
# =============================================

# --- Telegram Alerts ---
BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Inbound Webhook Auth ---
WEBHOOK_SECRET=your_webhook_secret_here

# --- Database (Required) ---
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# --- Real-Time Market Data ---
USE_TWELVEDATA=true
TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# --- Polygon.io (New Real-Time Streaming) ---
POLYGON_API_KEY=your_polygon_api_key_here

# --- Redis (Cache + Pub/Sub for real-time ticks) ---
REDIS_URL=redis://localhost:6379

# --- Optional Integrations ---
ALERTATRON_API_KEY=your_alertatron_key_here
METATRADER_LOGIN=your_mt5_login
METATRADER_PASSWORD=your_mt5_password
METATRADER_SERVER=your_mt5_server

# --- CORS ---
ALLOWED_ORIGINS=*

# --- USD/JPY Scanner ---
USDJPY_SCANNER_ENABLED=false
USDJPY_SCAN_HOUR_UTC=22
USDJPY_ACCOUNT_SIZE=0

# =============================================
# Notes:
# 1. Copy this file to .env locally
# 2. NEVER commit real secrets
# 3. On Render: Add these as Environment Variables
# 4. Get Polygon key at: https://polygon.io
# =============================================
