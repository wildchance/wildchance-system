# =============================================
# Wildchance System — Environment Variables
# =============================================

# --- Telegram Alerts ---
BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Inbound Webhook Auth ---
WEBHOOK_SECRET=your_webhook_secret_here

# --- Database (Required) ---
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# --- Real-Time Market Data ---
USE_TWELVEDATA=true
TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# --- Polygon.io (New Real-Time Streaming) ---
POLYGON_API_KEY=your_polygon_api_key_here

# --- Redis (Cache + Pub/Sub for real-time ticks) ---
REDIS_URL=redis://localhost:6379

# --- Optional Integrations ---
ALERTATRON_API_KEY=your_alertatron_key_here
METATRADER_LOGIN=your_mt5_login
METATRADER_PASSWORD=your_mt5_password
METATRADER_SERVER=your_mt5_server

# --- CORS ---
ALLOWED_ORIGINS=*

# --- USD/JPY Scanner ---
USDJPY_SCANNER_ENABLED=false
USDJPY_SCAN_HOUR_UTC=22
USDJPY_ACCOUNT_SIZE=0

# =============================================
# Notes:
# 1. Copy this file to .env locally
# 2. NEVER commit real secrets
# 3. On Render: Add these as Environment Variables
# 4. Get Polygon key at: https://polygon.io
# =============================================

# --- WildChance v4 (pipeline / lunar / prop challenge) ---
# Lunar overlay: ON by default; set false if GET /lunar/backtest shows no edge on your symbols
LUNAR_GATE_ENABLED=true
LUNAR_OBS_HOURS=24
LUNAR_PAUSE_IN_OBS=false
# Free data fallback when TwelveData is empty/out of credits (gold = GC=F futures, ~$20-40 off spot)
YAHOO_FALLBACK_ENABLED=false

# --- MT5 VPS connector (mt5_bridge/connector.py) — set on the VPS, not the app ---
# CHALLENGE_INITIAL_BALANCE=10000      # the challenge's starting balance (set it!)
# CHALLENGE_DAILY_LOSS=0.05            # firm daily loss (FundingPips 2-Step: 5%)
# CHALLENGE_MAX_LOSS=0.10              # firm max loss (10%)
# CHALLENGE_TARGET=0.08                # phase target (P1 0.08, P2 0.05, 0 = off)
# GUARD_DAILY_BUFFER=0.70              # stop at 70% of the daily limit (3.5%)
# GUARD_MAX_BUFFER=0.80                # stop at 80% of the max loss (8%)
# SYMBOL_MAP={"XAUUSD":"XAUUSD","EURUSD":"EURUSD"}   # unset = gold-only
# CHALLENGE_PRESET=fundingpips_2step_8   # 2step_8 | 2step_8_d3 | 2step_flex | 2step_pro |
#                                        # 1step | 1step_d2 | 1step_labs | zero (prefix fundingpips_)
# CHALLENGE_PHASE=1                      # 1 / 2 evaluation, 0 = funded

# --- EA data feed + swing engine ---
BRIDGE_TOKEN=change_me_long_random       # EA input InpBridgeToken must match
BROKER_FEED_ENABLED=true                 # use EA-pushed broker bars before TwelveData
REALTIME_ALERTS_ENABLED=true             # evaluate + Telegram on every EA bar push
ALERT_TTL_HOURS=12
# SWING_UNIVERSE=XAU/USD,XAG/USD,BTC/USD,WTI/USD,SPX,NDX,DJI,EUR/USD,GBP/USD,USD/JPY
# Stage-0 direction locks from your HTF analysis (e.g. the BTC expanded-flat map)
MACRO_BIAS={"BTCUSD":"SELL_ONLY"}

# --- AI sentiment (NVIDIA API, build.nvidia.com) ---
NVIDIA_API_KEY=your_nvidia_key
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
SENTIMENT_AUTO_BIAS=false        # true → strong+confident reads set BUY_ONLY/SELL_ONLY (manual MACRO_BIAS wins)
SENTIMENT_TTL_MIN=180

# --- In-app scheduler (/cron/tick) ---
CRON_TOKEN=change_me_long_random   # cron-job.org header X-Cron-Token + GitHub secret CRON_TOKEN

# --- Trade-quality gate (owner's rules) ---
MIN_RR=1.3                  # furthest TP must pay ≥ 1.3R (first sheet rung)
MIN_SL_PIPS=10              # FX stop floor (sheet: 100 points)
MIN_SL_GOLD_USD=3.0         # gold stop floor
BLOCK_CBDR_FORMING=true     # no new trades 14:00–20:00 New York while the box forms
ZC_NOTIFY_GRADES=A          # z-setups sent: A = z + confluence + COT + weekly profile all aligned
