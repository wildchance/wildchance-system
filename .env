BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

WEBHOOK_SECRET=your_webhook_secret_here

DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

USE_TWELVEDATA=true
TWELVEDATA_API_KEY=your_twelvedata_key_here

ALERTATRON_API_KEY=your_alertatron_key_here
METATRADER_LOGIN=your_mt5_login_optional
METATRADER_PASSWORD=your_mt5_password_optional
METATRADER_SERVER=your_mt5_server_optional

# --- USD/JPY forward-test scanner (optional) ---
# Auto-fetch the daily USD/JPY close once a day and run the signal engine.
USDJPY_SCANNER_ENABLED=false      # set true to run the daily auto-scan
USDJPY_SCAN_HOUR_UTC=22           # hour (0-23 UTC) to fetch the daily close
USDJPY_ACCOUNT_SIZE=0             # demo account size in USD for sizing alerts (0 = skip)
